# PostgreSQL (Docker default)
POSTGRES_USER=prepfreex
POSTGRES_PASSWORD=prepfreex_dev
POSTGRES_DB=prepfreex_qbank
POSTGRES_PORT=5432
DATABASE_URL=postgresql://prepfreex:prepfreex_dev@127.0.0.1:5432/prepfreex_qbank

# LLM Configuration
LLM_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
# Multiple Groq API keys for automatic round-robin rotation (comma-separated):
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4
LLM_REQUESTS_PER_MINUTE=25
MAX_LLM_TOKENS_PER_MINUTE=7000
MAX_LLM_REQUESTS_PER_DAY=850
MAX_LLM_TOKENS_PER_DAY=150000

# Optional fallback provider: gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional secondary provider: openai_compatible
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Extraction & Tagging Settings
TAG_CONFIDENCE_THRESHOLD=0.8
PDF_RENDER_DPI=200
SOURCE_SNAPSHOT_DPI=220
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MIN_TEXT_CHARS=80

# Local Storage
INPUT_DIR=data/input
ARTIFACT_DIR=artifacts
TAXONOMY_VERSION=jee_main_2027

# Object Storage Configuration (Local MinIO AIStor / AWS S3)
OBJECT_STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=prepfreex-question-assets
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=your_minio_app_access_key
MINIO_SECRET_KEY=your_minio_app_secret_key
MINIO_USE_SSL=false
MINIO_DATA_DIR=C:\PrepFreeX\minio-data

# AWS S3 Production (used when OBJECT_STORAGE_BACKEND=aws_s3)
AWS_S3_BUCKET=prepfreex-question-assets-prod
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
